DB_HOST=localhost
DB_PORT=1433
DB_NAME=nombre_base_datos
DB_USER=usuario
DB_PASSWORD=contraseña

# Clave secreta para firmar las sesiones de Flask.
# Genera una aleatoria, por ejemplo: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-aleatoria

# OBLIGATORIA: clave de cifrado (Fernet) de la relación producto->cliente(s)
# almacenada en clientes.dat. Sin ella, el análisis "Por cliente" y su gestión
# no están disponibles (el resto del app sigue funcionando).
# Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Debe ser una clave base64 de 32 bytes. No la compartas ni la subas al repo.
CLIENTES_KEY=genera-una-con-Fernet.generate_key
